{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2024"],
    "module": "nodenext",
    "strict": true,
    "experimentalDecorators": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "scripts", "*.config.ts"]
}
